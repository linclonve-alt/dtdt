# Copy to .env, fill in ONE broker section, then:  chmod 600 .env
# Never commit .env. It holds your keys.

# ---- Required ----
DOMAIN=trade.example.com            # your domain, its DNS A record pointing at this server
ACCESS_TOKEN=                       # python -c "import secrets; print(secrets.token_urlsafe(32))"
# One of: oanda binance bybit okx bitget gate kucoinfutures hyperliquid paradex
BROKER=binance

# ---- Risk and daily lock ----
RISK_PCT=1                          # % of account risked per trade (max 5 in the desktop wizard; keep it small)
LOCK_TZ=Asia/Manila                 # your timezone name
LOCK_RESET_HOUR=6                   # the day's one trade unlocks again at this hour (0-23)

# ---- CEX: binance bybit okx bitget gate kucoinfutures (API key, trade permission only, NO withdrawals) ----
EX_KEY=
EX_SECRET=
EX_PASSWORD=                        # only okx, bitget, kucoinfutures
EX_LIVE=0                           # 0 = testnet/demo (separate keys), 1 = real money
EX_PAIRS=BTC_USDT,ETH_USDT,SOL_USDT

# ---- DEX: hyperliquid (set BROKER=hyperliquid; pairs end in _USDC, e.g. BTC_USDC) ----
# EX_WALLET=0xYourMainWalletAddress
# EX_KEY=0xApiWalletPrivateKey      # an API wallet: can trade, cannot withdraw
# EX_LIVE=0

# ---- DEX: paradex (set BROKER=paradex) ----
# PARADEX_MODE=l1                   # l1 = zero-fee retail. subkey = safer, but may be charged Pro fees
# L1_ADDRESS=0x...
# L1_PRIVATE_KEY=0x...              # can move ALL funds in that wallet: use a wallet holding only trading money
# L2_ADDRESS=0x...                  # (subkey mode)
# L2_PRIVATE_KEY=0x...

# ---- OANDA (set BROKER=oanda) ----
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=101-001-1234567-001
# OANDA_LIVE=0
